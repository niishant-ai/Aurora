# AURORA — environment template
#
# Copy real values into .env.local (gitignored) for local work.
# Set the same two variables in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# ---------------------------------------------------------------
# DATABASE_URL  (required — the app throws at boot without it)
# ---------------------------------------------------------------
# Use the Supabase **Supavisor connection pooler, transaction mode** (port 6543),
# because Vercel Functions open many short-lived connections.
#
# Find it: Supabase dashboard → your project → Connect → "Transaction pooler".
# It looks like:
#
#   postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require
#
# Notes that matter for this app (all verified against a live deploy):
#   * pooled username is `postgres.<PROJECT-REF>`, NOT bare `postgres`
#   * `sslmode=require` is required — node-postgres defaults to no SSL
#   * `uselibpqcompat=true` is ALSO required on pg 8.20. Supabase presents a
#     certificate chain that does not verify on many networks (and behind a
#     TLS-inspecting proxy). pg >= 8.16 treats `sslmode=require` as an alias for
#     `verify-full`, which fails with "self-signed certificate in certificate
#     chain". The flag restores libpq semantics (encrypt, do not verify).
#   * do NOT add `pgbouncer=true` or `connection_limit=1`; those are Prisma flags
#     and are ignored by node-postgres. Pool size is set in src/db/index.ts (`max`).
#   * the pooler host cannot be guessed from the region — copy it from the dashboard.
#     Confirm it resolves: the wrong `aws-N` index returns "tenant/user ... not found".
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require

# Migrations and schema pushes only. Not read by the app at runtime.
#
# Use the SESSION pooler on port 5432 (same host and username as above) — NOT the
# `db.<PROJECT-REF>.supabase.co` host. That host is IPv6-only on free plans, so it
# fails with ENOTFOUND on IPv4-only networks. Session mode supports DDL;
# transaction mode does not.
DIRECT_DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require

# ---------------------------------------------------------------
# OPENAI_API_KEY (optional)
# ---------------------------------------------------------------
# Declared by the tech-stack doc but unused: the only live adapter is
# CitationLockedAdapter, which is deterministic and local.
# OPENAI_API_KEY=
